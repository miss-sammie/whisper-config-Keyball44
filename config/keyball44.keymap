#define BASE   0
#define FUN    1
#define NAV    2
#define MEDIA  3
#define MOUSE  4
#define SCROLL 5
#define SNIPE  6
#define ADJUST 7
#define NUM    8
#define SYM    9

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        // Keyball binding order per row:
        //   [outer-L] [Q..T] [Y..P] [outer-R]
        // Thumb row:
        //   [LGUI] [LALT] [ESC/MEDIA] [SPC/NAV] [TAB/FUN]  [ENT/SYM] [BSPC/NUM]  [SCROLL]
        //
        // Dilemma JSON right half is stored outer→inner (P=idx20, Y=idx24).
        // Keyball binding order is inner→outer (Y first), so right columns are reversed:
        //   col6(Y)=idx+4, col7(U)=idx+3, col8(I)=idx+2, col9(O)=idx+1, col10(P)=idx+0

        default_layer {
            label = "BASE";
            bindings = <
// outer-L    Q              W                   E              R              T              Y              U              I              O              P                outer-R
&kp ESCAPE    &kp Q          &kp W               &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P            &kp BACKSPACE
&kp LCTRL     &mt LGUI A     &mt LALT S          &mt LCTL D     &mt LSFT F     &kp G          &kp H          &mt LSFT J     &mt LCTL K     &mt LALT L     &mt LGUI SQT     &kp SQT
&kp LEFT_SHIFT &lt MOUSE Z   &mt (LALT|RALT) X   &kp C          &kp V          &kp B          &kp N          &kp M          &kp COMMA      &mt RALT DOT   &lt MOUSE SLASH  &mkp MB1
&kp LGUI      &kp LALT       &lt MEDIA ESCAPE    &lt NAV SPACE  &lt FUN TAB                   &lt SYM ENTER  &lt NUM BACKSPACE                                              &mo SCROLL
            >;
        };

        // Dilemma layer 1 — activated by TAB hold
        // L: mods on home row, RALT on X
        // R: PSCRN/SLCK/PAUSE on Y/H/N col; F7-F9/F4-F6/F1-F3 across; F12/F11/F10 on P col
        fun_layer {
            label = "FUN";
            bindings = <
&trans  &none     &none     &none     &none     &none    &kp PSCRN        &kp F7   &kp F8   &kp F9   &kp F12   &trans
&trans  &kp LGUI  &kp LALT  &kp LCTL  &kp LSFT  &none    &kp SLCK         &kp F4   &kp F5   &kp F6   &kp F11   &trans
&trans  &none     &kp RALT  &none     &none     &none    &kp PAUSE_BREAK  &kp F1   &kp F2   &kp F3   &kp F10   &trans
&trans  &trans    &none     &none     &trans              &none            &none                                  &trans
            >;
        };

        // Dilemma layer 2 — activated by SPACE hold
        // R: CAPS/arrows on H row; INS/HOME/PGDN/PGUP/END on bottom row
        nav_layer {
            label = "NAV";
            bindings = <
&trans  &none     &none     &none     &none     &none    &none      &none      &none      &none      &none      &trans
&trans  &kp LGUI  &kp LALT  &kp LCTL  &kp LSFT  &none    &kp CAPS   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans  &none     &kp RALT  &none     &none     &none    &kp INS    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &trans
&trans  &trans    &none     &trans    &none               &kp ENTER  &kp BACKSPACE                               &trans
            >;
        };

        // Dilemma layer 3 — activated by ESC hold
        // Both halves mirror: MPRV/VOLD/MUTE/VOLU/MNXT on home row
        // RM_TOGG omitted (no RGB on Keyball)
        media_layer {
            label = "MEDIA";
            bindings = <
&trans  &none        &none         &none       &none         &none        &none        &none         &none       &none         &none        &trans
&trans  &kp C_PREV   &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_NEXT   &kp C_PREV   &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_NEXT   &trans
&trans  &none        &none         &none       &none         &none        &none        &none         &none       &none         &none        &trans
&trans  &trans       &trans        &kp C_STOP  &kp C_PP                   &kp C_STOP   &kp C_PP                                             &trans
            >;
        };

        // Dilemma layer 4 — activated by Z or / hold
        // CUSTOM(6)=DRGSCRL→&mo SCROLL, CUSTOM(4)=SNIPING→&mo SNIPE
        // RESET→&bootloader; mouse buttons on thumbs
        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &bootloader  &none       &none      &none      &none    &none     &none      &none      &none       &none      &trans
&trans  &kp LGUI     &kp LALT    &kp LCTL   &kp LSFT   &none    &none     &kp LSFT   &kp LCTL   &kp LALT    &kp LGUI   &trans
&trans  &trans       &mo SCROLL  &mo SNIPE  &mkp MB3   &none    &none     &mkp MB3   &mo SNIPE  &mo SCROLL  &trans     &trans
&trans  &trans       &mkp MB3    &mkp MB1   &mkp MB2            &mkp MB1  &mkp MB2                                       &trans
            >;
        };

        // Keyball-specific: BT switching on top row, scroll layer active via dedicated thumb
        scroll_layer {
            label = "SCROLL";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_NXT   &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR    &trans        &trans        &trans        &trans        &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                     &trans  &trans                          &trans
            >;
        };

        // Keyball-specific: snipe mode; arrows on right home row
        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans        &trans        &trans             &trans           &trans   &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&trans  &kp LC(LEFT)  &kp LC(DOWN)  &kp LC(UP_ARROW)   &kp LC(RIGHT)    &trans   &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &trans        &trans        &kp LG(PG_DN)      &kp LG(PG_UP)    &trans   &trans  &trans    &trans        &trans     &trans  &trans
&trans  &trans        &trans        &trans             &trans                    &trans  &trans                              &trans
            >;
        };

        adjust_layer {
            label = "ADJUST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans           &trans  &trans                          &trans
            >;
        };

        // Dilemma layer 5 — activated by BSPC hold
        // L: numpad cluster; thumbs: MINUS/0/DOT override the hold-tap keys
        // R: mods on home row, RALT on dot column
        number_layer {
            label = "NUM";
            bindings = <
&trans  &kp LBKT  &kp N7   &kp N8   &kp N9  &kp RBKT      &none   &none      &none      &none     &none     &trans
&trans  &kp SEMI  &kp N4   &kp N5   &kp N6  &kp EQUAL     &none   &kp LSFT   &kp LCTL   &kp LALT  &kp LGUI  &trans
&trans  &kp DOT   &kp N1   &kp N2   &kp N3  &kp BACKSLASH &none   &none      &none      &kp RALT  &none     &trans
&trans  &trans    &kp DOT  &kp N0   &kp MINUS              &none   &trans                           &trans
            >;
        };

        // Dilemma layer 6 — activated by ENT hold
        // L: symbol cluster; thumbs: )/_ /` override the hold-tap keys
        // R: mods on home row, RALT on dot column
        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &kp LBRC   &kp AMPS   &kp ASTERISK  &kp LPAR   &kp RBRC   &none   &none      &none      &none     &none     &trans
&trans  &kp COLON  &kp DLLR   &kp PRCNT     &kp CARET  &kp PLUS   &none   &kp LSFT   &kp LCTL   &kp LALT  &kp LGUI  &trans
&trans  &kp TILDE  &kp EXCL   &kp AT        &kp HASH   &kp PIPE   &none   &none      &none      &kp RALT  &none     &trans
&trans  &trans     &kp RPAR   &kp UNDER     &kp GRAVE              &trans  &none                            &trans
            >;
        };
    };
};
